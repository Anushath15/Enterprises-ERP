{
  "name": "senthil-erp",
  "productName": "Senthil Enterprises ERP",
  "version": "1.0.0",
  "description": "Offline Retail ERP for Hardware Stores",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "pack:win": "electron-builder --dir"
  },
  "author": "Senthil Enterprises",
  "license": "ISC",
  "dependencies": {
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "puppeteer": "^25.5.0"
  },
  "build": {
    "appId": "com.senthil.erp",
    "productName": "Senthil Enterprises ERP",
    "copyright": "Copyright © 2026 Senthil Enterprises",
    "directories": {
      "output": "dist",
      "buildResources": "desktop/assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Senthil Enterprises ERP"
    },
    "files": [
      "desktop/**/*",
      "frontend/**/*",
      "node_modules/**/*"
    ]
  }
}
