# Senthil Enterprises ERP - Backend Environment Configuration Example
# Do not commit the actual .env file. Use this as a template.

# Database connection string (PostgreSQL using psycopg v3)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/senthil_erp

# JWT Security
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-goes-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST=0.0.0.0
PORT=8000
